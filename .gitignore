# ============================================================
# .gitignore — Production Security Hardened
# ============================================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Build output ---
dist/
build/
.next/
out/

# --- Environment & secrets (CRITICAL) ---
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env.*
# Keep .env.example — it documents required variables without values
!.env.example

# --- API keys / credentials ---
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.jks
serviceAccountKey.json
google-credentials.json
firebase-adminsdk*.json

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# --- Runtime / temp ---
*.pid
*.seed
*.pid.lock
.cache/
tmp/
temp/

# --- Test / Coverage ---
coverage/
.nyc_output/
*.lcov

# --- Uploads (user-generated content) ---
uploads/
public/uploads/

# --- Database ---
*.sql
*.sqlite
*.sqlite3
*.db
drizzle/meta/

# --- Docker ---
docker-compose.override.yml

# --- Misc ---
.turbo/
*.tsbuildinfo
.eslintcache

# --- Local secrets / large archives (never commit) ---
AG.txt
email.txt
configure_groq.js
*.zip

# --- Local documents ---
*.pdf
